# 驱动
DRIVER=~fastapi+~websockets

# NapCat WebSocket 连接
ONEBOT_WS_URLS=["ws://你的NapCat地址:端口/onebot/v11/ws"]

# LLM
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_API_ENDPOINT=https://api.anthropic.com
CLAUDE_MODEL=claude-opus-4-6
MAX_TOKENS=16384
LLM_TIMEOUT_SEC=120

# thinking 模式：disabled / adaptive / enabled
THINKING_MODE=disabled
# enabled 模式下的 thinking token 预算
THINKING_BUDGET=8192

# Bot 身份
BOT_NAME=48                 # bot 在群里的名字（用于识别自己的发言）
OWNER_ID=填创造者的QQ号      # 创造者/特殊用户，享有 3 倍速率限制豁免

# 允许发言的群（不配置 = 不在任何群说话）
ALLOWED_GROUPS=["群号1","群号2"]

# Qdrant 向量数据库地址
QDRANT_URL=http://localhost:6333

# SurrealDB 人物图谱
SURREALDB_URL=ws://localhost:8000
SURREALDB_USER=root
SURREALDB_PASSWORD=root

# 速率限制（每用户每分钟请求数）
RATE_PER_MINUTE=5

# 每日 API 调用上限（到了就闭嘴）
DAILY_LIMIT=500

# 重复消息缓存秒数（同人同消息直接走缓存不调 API）
CACHE_TTL=30

# 记忆检索数量
MEMORY_SEARCH_LIMIT=4           # 相关记忆条数
DIARY_LIMIT=3                   # 日记（我的近况）条数
IMPRESSION_RECENT_LIMIT=3       # 近期印象条数
IMPRESSION_KEY_LIMIT=2          # 关键印象条数
STORY_SEARCH_LIMIT=2            # 故事检索条数

# 日程生成用的日记数量（比对话时多拉，让日程更贴合近况）
SCHEDULE_DIARY_LIMIT=10         # 近期日记条数
SCHEDULE_DIARY_KEY_LIMIT=10     # 重要日记条数

# 主动行为
PROACTIVE_CHECK_SEC=7200        # 检查间隔（秒），默认 2 小时
PROACTIVE_COOLDOWN_SEC=21600    # 主动消息冷却（秒），默认 6 小时
PROACTIVE_MAX_DAILY=2           # 每天最多主动几次

# 日记自动去重（可选）
# DIARY_DEDUP_ENABLED=false
# DIARY_DEDUP_THRESHOLD=0.85
# DIARY_DEDUP_WINDOW=15
